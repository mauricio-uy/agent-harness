#!/bin/sh
# Check the staged documentation before each commit. Enable it once per clone:
#   git config core.hooksPath .githooks
set -eu

if ! command -v harness >/dev/null 2>&1; then
    echo 'The harness CLI is not on PATH; install it to run the documentation checks.' >&2
    exit 1
fi
cd "$(git rev-parse --show-toplevel)"
exec harness check --staged
