#!/bin/sh
# Check the staged documentation before each commit. Enable it once per clone:
#   git config core.hooksPath .githooks
# Without the harness CLI the commit goes ahead with a warning. Set
# HARNESS_HOOK_STRICT=1 to block the commit instead.
set -eu

if ! command -v harness >/dev/null 2>&1; then
    if [ "${HARNESS_HOOK_STRICT:-0}" = 1 ]; then
        echo 'The harness CLI is not on PATH; install it to run the documentation checks.' >&2
        exit 1
    fi
    echo 'Warning: the harness CLI is not on PATH, so the documentation checks were skipped.' >&2
    exit 0
fi
cd "$(git rev-parse --show-toplevel)"
exec harness check --staged
